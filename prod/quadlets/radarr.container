[Unit]
Description=Radarr

[Container]
ContainerName=radarr
Image=lscr.io/linuxserver/radarr:version-6.4.4.10685
AutoUpdate=registry
UserNS=keep-id
EnvironmentFile=/home/mjdescy/prod/radarr/.env

Network=proxy.network

Volume=/home/mjdescy/prod/radarr/config:/config:Z
Volume=/tank/video/movies:/movies:z
Volume=/home/mjdescy/prod/sabnzbd/config/Downloads:/downloads:z

# PublishPort=7878:7878

[Service]
Restart=always

[Install]
WantedBy=default.target