[Unit]
Description=Paperless Valkey broker

[Container]
ContainerName=paperless-broker
Image=docker.io/valkey/valkey:9.1.1-alpine
AutoUpdate=registry
UserNS=keep-id
User=1000:1000

Network=proxy.network

Volume=/home/mjdescy/prod/paperless/redisdata:/data:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
